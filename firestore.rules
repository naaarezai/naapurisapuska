rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions for cleaner rules
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    function isValidFoodItem() {
      return request.resource.data.keys().hasAll(['title', 'userId', 'timestamp', 'latitude', 'longitude']) &&
             request.resource.data.title is string &&
             request.resource.data.title.size() >= 3 &&
             request.resource.data.title.size() <= 100 &&
             request.resource.data.latitude is number &&
             request.resource.data.longitude is number &&
             // Enforce server timestamp within a 1-minute window
             request.resource.data.timestamp is timestamp &&
             request.resource.data.timestamp > request.time - duration.value(1, 'm') &&
             request.resource.data.timestamp <= request.time;
    }
    
    // Ruokailmoitukset (Food Items)
    match /food_items/{itemId} {
      allow read: if true;
      
      allow create: if isAuthenticated() && 
                       request.resource.data.userId == request.auth.uid &&
                       isValidFoodItem();
      
      allow update: if isOwner(resource.data.userId) ||
                       (isAuthenticated() && 
                        request.resource.data.diff(resource.data).affectedKeys()
                          .hasOnly(['status', 'reservedByUserId', 'reservedAt', 'isReserved', 'pickedUpAt']) &&
                        (
                          // Case 1: Reserving (Must be currently available)
                          (resource.data.status == 'available' &&
                           request.resource.data.status == 'reserved' &&
                           request.resource.data.reservedByUserId == request.auth.uid &&
                           request.resource.data.reservedAt == request.time)
                          ||
                          // Case 2: Unreserving (Must be reserved by me)
                          (resource.data.reservedByUserId == request.auth.uid &&
                           request.resource.data.status == 'available' &&
                           request.resource.data.reservedByUserId == null)
                        ));
      
      allow delete: if isOwner(resource.data.userId);
      
      match /ratings/{ratingId} {
        allow read: if true;
        allow create: if isAuthenticated() &&
                         request.resource.data.userId == request.auth.uid &&
                         request.resource.data.rating is number &&
                         request.resource.data.rating >= 1 &&
                         request.resource.data.rating <= 5;
        allow update, delete: if isOwner(resource.data.userId);
      }
    }
    
    // Käyttäjätiedot (Users)
    match /users/{userId} {
      allow read: if true;
      allow create, update: if isOwner(userId);
      allow delete: if isOwner(userId);
      
      match /favorites/{favoriteId} {
        allow read: if isOwner(userId);
        allow create, update, delete: if isOwner(userId);
      }
    }
    
    // Chatit (Chats)
    match /chats/{chatId} {
      allow read: if isAuthenticated() && 
                     (chatId.split('_')[0] == request.auth.uid || 
                      chatId.split('_')[1] == request.auth.uid ||
                      (resource != null && request.auth.uid in resource.data.participants));
      
      allow create: if isAuthenticated() &&
                       request.auth.uid in request.resource.data.participants &&
                       request.resource.data.participants.size() == 2;
      
      allow update: if isAuthenticated() && 
                       request.auth.uid in resource.data.participants;
      
      allow delete: if false;
      
      match /messages/{messageId} {
        allow read: if isAuthenticated() && 
                       request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
        
        allow create: if isAuthenticated() &&
                         request.resource.data.senderId == request.auth.uid &&
                         request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants &&
                         request.resource.data.timestamp <= request.time;
        
        allow update: if isOwner(resource.data.senderId) || 
                         (isAuthenticated() && 
                          request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants &&
                          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead']));
        
        allow delete: if isOwner(resource.data.senderId);
      }
    }

    // Ilmoitukset (Notifications)
    match /notifications/{notificationId} {
      // Vain ilmoituksen kohdekäyttäjä voi lukea ja muokata omiaan
      allow read: if isAuthenticated() && 
                     request.auth.uid == resource.data.userId;
      
      // Estetään käyttäjiä luomasta ilmoituksia suoraan - vain admin/functions pitäisi
      // Jos sovellus vaatii tämän, rajataan vain omaan ID:hen
      allow create: if false; // Vain Cloud Functions luo ilmoitukset
      
      allow update, delete: if isAuthenticated() && 
                               request.auth.uid == resource.data.userId;
    }
  }
}
